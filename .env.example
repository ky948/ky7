# AI provider
GEMINI_API_KEY=

# Application
APP_URL=http://localhost:3000
PORT=3000
NODE_ENV=production

# Trading mode: LIVE_VAULT uses the connected Binance Spot account.
TRADING_MODE=LIVE_VAULT
LIVE_AUTONOMOUS_ENABLED=false
MAX_CAPITAL_ALLOCATION=0.25
MAX_POSITION_SIZE=0.10
MAX_DAILY_LOSS=0.03
MAX_DRAWDOWN=0.10

# Persistence / coordination
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ky7
POSTGRES_USER=ky7
POSTGRES_PASSWORD=change-me
DATABASE_URL=
REDIS_URL=redis://localhost:6379

# Profit sweep: disabled by default; configure only after wallet/network verification.
PROFIT_SWEEP_ENABLED=false
PROFIT_SWEEP_MINIMUM=50
PROFIT_SWEEP_PERCENTAGE=50
DESTINATION_WALLET=
DESTINATION_NETWORK=

# Binance live execution (never commit actual values)
BINANCE_BASE_URL=https://api.binance.com
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_RECV_WINDOW=5000
BINANCE_IP_RESTRICTION_REQUIRED=true

# Real withdrawals are disabled unless explicitly enabled and the destination is allow-listed.
BINANCE_ENABLE_WITHDRAWALS=false
BINANCE_WITHDRAW_ALLOWLIST=
PROFIT_SWEEP_ASSET=USDT
DESTINATION_WALLET=
DESTINATION_NETWORK=
